# Example rex-sessionizer configuration.
#
# Rex is the terminal at https://www.superlogical.com/rex/docs/ .
#
# A config is required for the picker: there are no built-in search paths.
# Set REX_SESSIONIZER_SEARCH_PATHS below to the directories you want to search.
#
# Copy this to ${XDG_CONFIG_HOME:-$HOME/.config}/rex/rex-sessionizer.conf,
# or put a rex-sessionizer.conf in a project directory to override settings
# there. With a remote Rex server, this file belongs on the server machine.
#
# This file is sourced by bash, so arrays and command substitution work.
# Only source config files from directories you trust.

# Directories to search for projects. Each entry is searched to
# REX_SESSIONIZER_MAX_DEPTH, or use DIR:DEPTH for one entry.
#
# Replace these with your own project roots. Entries that don't exist are
# skipped, so if none of them exist the picker lists sessions only.
REX_SESSIONIZER_SEARCH_PATHS=(
  ~/code
  ~/src
  ~/personal:2
)

# Additional search paths appended to the list above. The default is empty.
# REX_SESSIONIZER_EXTRA_SEARCH_PATHS=(
#   ~/work
# )

# Default depth for entries without a :DEPTH suffix.
REX_SESSIONIZER_MAX_DEPTH=1

# Directory names to skip while searching (matched with find -name).
# The default is (.git), so hidden directories and .git are pruned. Set this
# to an empty array to prune nothing except hidden directories.
# REX_SESSIONIZER_EXCLUDES=(.git node_modules target)

# Rectangle for the floating picker opened by --popup, as x y w h fractions
# of the current Rex window. The default is centered at 80% by 80%.
# REX_SESSIONIZER_POPUP_BOUNDS=(0.1 0.1 0.8 0.8)

# Hidden directories are skipped by default. Set to 1 to include them.
# REX_SESSIONIZER_INCLUDE_HIDDEN=0

# Symlinked project directories are skipped by default. Set to 1 to follow
# them (find -L; useful for symlinked dotfiles/projects).
# REX_SESSIONIZER_FOLLOW_SYMLINKS=0

# Commands available with -s/--session INDEX. They run through `sh -c` in the
# current directory, in a new window or (with --vsplit/--hsplit) a split.
# The default is an empty list, which makes -s/--session unavailable.
REX_SESSIONIZER_COMMANDS=(
  "lazygit"
  "nvim"
  "htop"
)

# Keep a command window open after the program exits. The default is 0, which
# means one-shot commands (make test, etc.) close their pane and are recreated
# next time. Set to 1 if you prefer to inspect the output and rerun in place.
# REX_SESSIONIZER_KEEP_OPEN=0

# Rex app client to switch when more than one app is connected. Use a label
# from `rex client ls`, or a client ID. The default is $REX_CLIENT.
# REX_SESSIONIZER_CLIENT="MacBook Pro M1"

# Rex server to use (host label or address), and a default target session for
# -s. The command-line flags -S/--server and -t/--target override these.
# Defaults: empty, so Rex's $REX_SERVER applies and no target is set.
# REX_SESSIONIZER_SERVER="studio"
# REX_SESSIONIZER_TARGET="alpha"

# Source .rex-sessionizer (local, then ~/.rex-sessionizer) in new sessions.
REX_SESSIONIZER_HYDRATE=1

# Set to 0 to create/select sessions without switching the app.
REX_SESSIONIZER_SWITCH=1

# Logging. Values: echo, file, or empty for no logging (the default).
# REX_SESSIONIZER_LOG=file

# Log path used when REX_SESSIONIZER_LOG=file. The default is
# ${XDG_DATA_HOME:-$HOME/.local/share}/rex-sessionizer/rex-sessionizer.log.
# REX_SESSIONIZER_LOG_FILE=${XDG_DATA_HOME:-$HOME/.local/share}/rex-sessionizer/rex-sessionizer.log
